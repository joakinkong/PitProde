# Copiá este archivo como backend/.env SOLO para pruebas locales (está en .gitignore: nunca se sube).
# En internet, estas variables se cargan en el panel de Render, no en un archivo.

# Cadena de conexión a Postgres (Neon). Si no está, se usa SQLite en backend/datos/.
DATABASE_URL=

# Contraseña del organizador (mínimo 8 caracteres). Obligatoria si HOST no es local.
ORGANIZER_PASSWORD=

# Dirección del frontend publicado (Netlify), para CORS. Se pueden separar varias con comas.
FRONTEND_URL=

# En Render: 0.0.0.0. En tu PC: no hace falta.
HOST=
